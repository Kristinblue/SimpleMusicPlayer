{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug SimpleMusicPlayer (GDB)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/Debug/SimpleMusicPlayer.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "${config:cmake.debugConfig.miDebuggerPath}",
            "stopAtEntry": false,
            "externalConsole": false,
            "preLaunchTask": "CMake: build Debug",
            "setupCommands": [
                {
                    "description": "Enable GDB pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
